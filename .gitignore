# Reference papers — copyright; cite in ACKNOWLEDGEMENTS.md instead
Paper/
paper_draft/

# Local AWS credentials/keys for the Genos-m cloud run — never commit
.aws-genos-m/

# Manuscript drafts — working copy, not ready for the public repo
paper_draft/

# Reference-database snapshots, sequences, embeddings — never commit (large; download/build via scripts)
# includes GTDB releases, Pfam/UniProt dumps, FASTA, and cached embedding matrices.
# Small derived artifacts (manifest, summary stats, sampled panels) ARE committed —
# see docs/reproducibility.md and Track1_phase1_benchmark_scope.md section 6 ("the
# committed artifact; sequences and embeddings stay gitignored") — so this ignores
# data/ contents rather than the directory itself, with explicit un-ignores below.
/data/*
!/data/manifest.json
!/data/.ops/
!/data/processed/
/data/processed/*
!/data/processed/*/
/data/processed/*/*
!/data/processed/*/*.json
!/data/processed/*/*.csv
/data/processed/*/taxonomy.csv

# External tools cloned/built locally, not vendored (e.g. Foldseek binaries) — see README/ACKNOWLEDGEMENTS
tools/

# Model checkpoints, cached embeddings, and run outputs
checkpoints/
embeddings/
outputs/
runs/
models_cache/
.cache/

# Weights & Biases
wandb/

